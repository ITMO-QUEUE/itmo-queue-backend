APP_NAME=ITMO.Queue
ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=itmo_queue
POSTGRES_USER=itmo_queue
# Replace this local placeholder before starting Compose. Never commit .env.
POSTGRES_PASSWORD=change-me-locally

REDIS_URL=redis://localhost:6379/0
# Use false only for local HTTP development; HTTPS is required when true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400

# Frontend origins (JSON array); use a shared origin/proxy in production.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
