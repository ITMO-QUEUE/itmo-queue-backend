{
	"nodes":[
		{"id":"api","type":"text","text":"# `src/itmo_queue/api/`\n\nFastAPI routers, request/response DTOs, validation, dependency wiring.\n\n**Depends on:** public application contracts only.","x":550,"y":-90,"width":310,"height":210},
		{"id":"queues","type":"text","text":"# `modules/queues/`\n\nLive queue + slot-based queue, joins/cancellations, calling/skipping and defense results.\n\n**Owns queue state machine.**","x":1650,"y":500,"width":340,"height":250},
		{"id":"pg","type":"text","text":"# PostgreSQL\n\nPrimary source of truth: users/identities, academic data, sessions, queue state, results, audit and Outbox.\n\nBusiness change + Outbox row in one transaction.","x":2400,"y":2150,"width":300,"height":220},
		{"id":"tests","type":"text","text":"# `tests/`\n\nUnit, integration and API contract tests.\n\nTest public boundaries and cross-adapter behaviour.","x":-700,"y":1300,"width":300,"height":190},
		{"id":"academic","type":"text","text":"# `modules/academic/`\n\nCourses, lab works, participants and academic groups.","x":1100,"y":-200,"width":300,"height":180},
		{"id":"sessions","type":"text","text":"# `modules/sessions/`\n\nDefense sessions, status, time slots and scheduling.","x":705,"y":940,"width":300,"height":180},
		{"id":"core","type":"text","text":"# `src/itmo_queue/core/`\n\nConfig, common exceptions, logging and cross-cutting primitives.\n\nKeep domain rules out.","x":240,"y":950,"width":310,"height":170},
		{"id":"worker","type":"text","text":"# `src/itmo_queue/workers/`\n\nOutbox dispatch, retries, notification delivery and maintenance jobs.\n\nHandlers must be idempotent.","x":3630,"y":1160,"width":320,"height":220},
		{"id":"redis","type":"text","text":"# Redis\n\nCache, short-lived counters/data and inter-instance event fan-out.\n\nNot the sole durable record of queue state.","x":2600,"y":1740,"width":300,"height":220},
		{"id":"contracts","type":"text","text":"# `packages/contracts-ts/`\n\nTypeScript types derived from FastAPI OpenAPI.\n\nContract only; no duplicate business logic.","x":3560,"y":2055,"width":300,"height":225},
		{"id":"audit","type":"text","text":"# `modules/audit/`\n\nAudit trail for security-sensitive and business-significant actions.","x":2510,"y":1270,"width":340,"height":170},
		{"id":"infra","type":"text","text":"# `src/itmo_queue/infrastructure/`\n\nTechnical adapters: PostgreSQL, Redis, transaction boundary, event transport.\n\n**Implements ports declared by modules.**","x":1720,"y":1740,"width":330,"height":220},
		{"id":"docs","type":"text","text":"# `docs/decisions/`\n\nADRs for queue state machine, auth proof, Redis TTL/invalidation and event delivery.","x":1160,"y":1160,"width":300,"height":150},
		{"id":"notifications","type":"text","text":"# `modules/notifications/`\n\nNotification requests, delivery history and retries.","x":2355,"y":970,"width":310,"height":190},
		{"id":"realtime","type":"text","text":"# `modules/realtime/`\n\nSSE subscriptions, filters and state updates.\n\nDoes not own durable queue state.","x":2200,"y":240,"width":310,"height":190},
		{"id":"auth","type":"text","text":"# `modules/auth/`\n\nIdentity, login provider, roles and permissions.\n\nOwns auth use cases and its ports.","x":2550,"y":-20,"width":300,"height":190},
		{"id":"itmoid","type":"text","text":"# `modules/integrations/itmoid/`\n\nFuture ITMO.ID provider and identity synchronization. Isolates external protocol.","x":3370,"y":120,"width":340,"height":190},
		{"id":"migrations","type":"text","text":"# `migrations/`\n\nVersioned PostgreSQL schema changes via Alembic.","x":2400,"y":2520,"width":300,"height":150},
		{"id":"outside","type":"text","text":"# External clients\n\nWeb / mobile\n\nOutside this repository.\nREST + SSE","x":550,"y":-720,"width":260,"height":150}
	],
